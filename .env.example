# Cloudflare API token + account ID
# https://dash.cloudflare.com/profile/api-tokens
# 권한: Workers Scripts(Edit), Workers Tail(Read), Pages(Read),
#       Workers Routes(Edit), Zone Settings(Read), DNS(Read) — aiweb2026.site zone에만
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Personal Access Token (Classic)
# https://github.com/settings/tokens/new
# 권한: public_repo
# 용도: /api/stats가 학생 repo의 giscus 반응/댓글/pushed_at 조회 (GraphQL)
# production Worker에는 wrangler secret put GITHUB_TOKEN으로도 등록해야 함
GITHUB_TOKEN=
